# ---- Supabase (optional for v2 endpoints) ----
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ---- AI inference ----
# nugen (required for hackathon prizes) | lmstudio | ollama
LLM_PROVIDER=nugen
# tried in order if the primary fails; "offline" = rule-based text, always last
LLM_FALLBACKS=offline

# Nugen: platform.nugen.in -> API Keys, and Models -> Domain-Aligned Models -> copy Model ID (after deploying)
NUGEN_API_KEY=
NUGEN_MODEL_ID=
NUGEN_BASE_URL=https://api.nugen.in/api/v3/inference

# LM Studio: start the local server (Developer tab), load a model, copy its identifier
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Ollama (alternative local runtime)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

CORS_ORIGINS=https://carbon-ai-ten.vercel.app,http://localhost:5173,http://localhost:4173
